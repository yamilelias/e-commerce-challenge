# Copy to .env, then replace every required placeholder with private values.
# Keep this file out of image build contexts and never commit .env.
# If WEB_PORT changes, set PUBLIC_ORIGIN to the matching browser origin.
# Quote a generated ADMIN_PASSWORD_HASH with single quotes in .env when it contains $.
WEB_PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
APP_SECRET=REPLACE_WITH_RANDOM_HEX_32_BYTES
ADMIN_USERNAME=REPLACE_WITH_PRIVATE_ADMIN_NAME
ADMIN_PASSWORD_HASH=REPLACE_WITH_SYMFONY_COMPATIBLE_PASSWORD_HASH
RECEIPT_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_HEX_32_BYTES
